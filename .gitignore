# Checkpoints -- large, requester-pays, never in git
checkpoints/
*.msgpack
*.orbax-checkpoint*
*.npy

# Fluency reference model weights (T3.2). Normally live outside the repo under
# TRUSTGATE_REFERENCE_CACHE; this is belt-and-braces in case someone points the
# cache at the working tree. 548MB of GPT-2 must not reach a git history whose
# value is its dated commit timeline.
*.safetensors
reference-models/

# Experiment outputs
outputs/
experiments/*/results/
experiments/*/runs/
wandb/
*.jsonl

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Env / secrets (GCP billing project id, etc.)
.env
# Google service-account keys (GPU session 1 runbook). The repo is public.
*sa-key*.json
*service-account*.json
*.local

# Local working docs (not part of the tracked tree)
ROADMAP.md
HANDOFF.md
TEAM_PLAN.md

# OS
.DS_Store
Thumbs.db

# graphify internals (keep the graph outputs, drop cache + scratch)
graphify-out/cache/
graphify-out/.graphify_*
graphify-out/_run_*.py
